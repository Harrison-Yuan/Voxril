OPENBLAS_NUM_THREADS = 4
no_proxy = localhost, 127.0.0.1, ::1

# Gradio 独立模式使用的路径配置（Tauri 桌面应用通过代码动态设置，不依赖此文件）
# 目录结构说明：
#   workspace/data/{exp_dir}/   - 预处理数据（音频切片/F0/HuBERT特征）
#   workspace/models/{exp_dir}/ - 模型产物（checkpoint/索引/日志）
#   assets/hubert/              - HuBERT 基础模型
#   assets/rmvpe/               - RMVPE 基础模型
#   assets/indices/             - 共享索引文件

weight_root = assets/weights
weight_uvr5_root = assets/uvr5_weights
index_root = logs
outside_index_root = assets/indices
rmvpe_root = assets/rmvpe
